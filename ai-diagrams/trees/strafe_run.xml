<?xml version="1.0" encoding="UTF-8"?>
<!--
  StrafeRun: commit to a pass. Turn onto the bullet-speed lead with this
  burst's aim error, thrust when roughly lined up, fire bursts, and run
  until the phase timer ends (SUCCESS hands over to breakingOff). With no
  target it lets go of every key and fails.

  Ported key for key from the StrafeRun lambda in Behaviors.kt, which a
  test (StrafeRunTreeTest) uses as the reference.
-->
<root BTCPP_format="4" main_tree_to_execute="StrafeRun">
  <BehaviorTree ID="StrafeRun">
    <ReactiveFallback>
      <ReactiveSequence name="pass">
        <HasTarget/>
        <AimAndFire bearing="{aimBearing}"/>
        <ThrustWithin bearing="{aimBearing}"/>
        <KeysOff keys="stabilize,afterburner,booster"/>
        <CountDownPhase/>
      </ReactiveSequence>
      <ForceFailure name="noTarget">
        <ReleaseAllKeys/>
      </ForceFailure>
    </ReactiveFallback>
  </BehaviorTree>
</root>
